# Copy to deploy/.env on the server and fill in. Never commit .env.

# Domain for HTTPS. No domain? Use your server IP with dashes + .sslip.io, e.g. 49-12-34-56.sslip.io
SITE_ADDRESS=49-12-34-56.sslip.io

ANTHROPIC_API_KEY=sk-ant-...
DAILY_BUDGET_EUR=3.00
SESSION_BUDGET_EUR=1.00
ADMIN_CODE=choose-something-long
# USD_TO_EUR=0.92

# Keep promotions and the daily spend in Supabase (same value as in Streamlit secrets).
PROMOS_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
